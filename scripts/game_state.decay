// First playable Mujaffa parity slice.
//
// The values below are taken from the Norwegian 1.6 SWF rather than memory or
// modern balancing guesses. Presentation is deliberately primitive: this file
// owns gameplay state and only drives a few debug shapes so browser builds can
// prove the state machine before remastered art exists.

script GameState {
    // Deterministic test seed. The original SWF uses random(), but parity work
    // needs a repeatable stream in editor, native and browser builds.
    @export let parity_seed: f32 = 2003.0;

    // Original global/run state.
    var phase: f32 = 0.0; // 0 route select, 1 running, 2 result
    var route: f32 = 1.0;
    var level: f32 = 1.0;
    var bane: f32 = 0.0;
    var cool: f32 = 0.0;
    var cool_old: f32 = 0.0;
    var energi: f32 = 1.0;
    var penge: f32 = 5000.0;
    var koert: f32 = 0.0;
    var top_time: f32 = 0.0;
    var speed: f32 = 20.0;
    var status: f32 = 1.0;

    // Frame-794 run state recovered from the SWF.
    var gummi_safe: f32 = 0.0;
    var pickup: f32 = 0.0;
    var bil: f32 = 0.0;
    var dansk_pige: f32 = 0.0;
    var fetter: f32 = 0.0;
    var kondom: f32 = 0.0;
    var person: f32 = 0.0;
    var domi: f32 = 0.0;
    var danskpige: f32 = 0.0;
    var fettercount: f32 = 0.0;
    var vej_over: f32 = 0.0;
    var vej_over2: f32 = 0.0;
    var vej_kondom: f32 = 0.0;
    var vej_person: f32 = 0.0;
    var vej_dyr: f32 = 0.0;
    var vej_nr: f32 = 0.0;
    var vej_domi: f32 = 1.0;

    var fetter_1: f32 = 0.0;
    var fetter_2: f32 = 0.0;
    var fetter_3: f32 = 0.0;
    var fetter_4: f32 = 0.0;
    var pige_1: f32 = 0.0;
    var pige_2: f32 = 0.0;
    var pige_3: f32 = 0.0;

    // Temporary presentation handles. They are not authoritative state.
    var route_one: Entity = null;
    var route_two: Entity = null;
    var route_three: Entity = null;
    var car: Entity = null;
    var status_one: Entity = null;
    var status_two: Entity = null;
    var status_three: Entity = null;
    var status_four: Entity = null;
    var status_five: Entity = null;

    fn start() {
        this.route_one = World.find("Route 1");
        this.route_two = World.find("Route 2");
        this.route_three = World.find("Route 3");
        this.car = World.find("Parity Car");
        this.status_one = World.find("Status 1");
        this.status_two = World.find("Status 2");
        this.status_three = World.find("Status 3");
        this.status_four = World.find("Status 4");
        this.status_five = World.find("Status 5");
        reset_game();
    }

    fn reset_game() {
        // Frame 202: confirmed initial values.
        this.phase = 0.0;
        this.route = 1.0;
        this.level = 1.0;
        this.bane = 0.0;
        this.top_time = 0.0;
        this.cool = 0.0;
        this.cool_old = 0.0;
        this.speed = 20.0;
        this.energi = 1.0;
        this.penge = 5000.0;
        this.koert = 0.0;
        this.status = 1.0;
        refresh_visuals();
    }

    fn select_route(selected: f32) {
        if selected < 1.0 || selected > 3.0 {
            return;
        }
        this.route = selected;
        this.level = selected;
        refresh_visuals();
    }

    fn begin_run() {
        // Frame 743 snapshots cool before returning through the route dispatcher.
        this.cool_old = this.cool;

        // Frame 794: exact reset values and AS1 RandomNumber ranges.
        this.bane = 0.0;
        this.gummi_safe = 0.0;
        this.pickup = 0.0;
        this.speed = 20.0;
        this.bil = 0.0;
        this.dansk_pige = 0.0;
        this.fetter = 0.0;
        this.kondom = 0.0;
        this.person = 0.0;
        this.domi = 0.0;
        this.danskpige = 0.0;
        this.fettercount = 0.0;
        this.vej_over = 0.0;
        this.vej_over2 = 0.0;
        this.vej_kondom = 0.0;
        this.vej_person = 0.0;
        this.vej_dyr = 0.0;
        this.vej_nr = 0.0;
        this.vej_domi = 1.0;
        this.koert = 0.0;

        Random.seed(this.parity_seed);
        this.fetter_1 = Random.int(0.0, 99.0) + 200.0;
        this.fetter_2 = Random.int(0.0, 199.0) + 500.0;
        this.fetter_3 = Random.int(0.0, 199.0) + 800.0;
        this.fetter_4 = Random.int(0.0, 199.0) + 900.0;
        this.pige_1 = Random.int(0.0, 199.0) + 200.0;
        this.pige_2 = Random.int(0.0, 149.0) + 600.0;
        this.pige_3 = Random.int(0.0, 99.0) + 900.0;

        this.phase = 1.0;
        refresh_visuals();
    }

    fn finish_run() {
        this.koert = 1.0;
        this.status = status_for_cool(this.cool);
        this.phase = 2.0;
        refresh_visuals();
    }

    fn return_to_garage() {
        // The original snapshots current cool before dispatching back out.
        this.cool_old = this.cool;
        this.phase = 0.0;
        refresh_visuals();
    }

    fn status_for_cool(value: f32) -> f32 {
        // Frame 529 exact tier boundaries:
        // <200, 200..599, 600..1199, 1200..2499, >=2500.
        if value < 200.0 { return 1.0; }
        if value < 600.0 { return 2.0; }
        if value < 1200.0 { return 3.0; }
        if value < 2500.0 { return 4.0; }
        return 5.0;
    }

    fn update(dt: f32) {
        if this.phase == 0.0 {
            if Input.just_pressed("Digit1") { select_route(1.0); }
            if Input.just_pressed("Digit2") { select_route(2.0); }
            if Input.just_pressed("Digit3") { select_route(3.0); }
        }

        if Input.just_pressed("Space") {
            if this.phase == 0.0 {
                begin_run();
            } else if this.phase == 1.0 {
                finish_run();
            } else {
                return_to_garage();
            }
        }

        if Input.just_pressed("KeyR") {
            reset_game();
        }
    }

    fn refresh_visuals() {
        // Three route markers are deliberately just debug geometry. They let a
        // Pages build prove state changes without tying rules to future art.
        this.route_one.transform.scale.x = 1.35;
        this.route_one.transform.scale.y = 0.42;
        this.route_two.transform.scale.x = 1.35;
        this.route_two.transform.scale.y = 0.42;
        this.route_three.transform.scale.x = 1.35;
        this.route_three.transform.scale.y = 0.42;

        if this.route == 1.0 {
            this.route_one.transform.scale.x = 1.75;
            this.car.transform.position.x = -3.0;
        } else if this.route == 2.0 {
            this.route_two.transform.scale.x = 1.75;
            this.car.transform.position.x = 0.0;
        } else {
            this.route_three.transform.scale.x = 1.75;
            this.car.transform.position.x = 3.0;
        }

        World.set_active(this.car, this.phase > 0.0);
        World.set_active(this.status_one, this.phase == 2.0);
        World.set_active(this.status_two, this.phase == 2.0 && this.status >= 2.0);
        World.set_active(this.status_three, this.phase == 2.0 && this.status >= 3.0);
        World.set_active(this.status_four, this.phase == 2.0 && this.status >= 4.0);
        World.set_active(this.status_five, this.phase == 2.0 && this.status >= 5.0);
    }
}
