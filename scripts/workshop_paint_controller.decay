// LAKKERING mirrors the original two-step flow: the normal panel contains
// `skift`; pressing it opens the native RGB sliders and OK commits the preview.
script WorkshopPaintController {
    var red: f32 = 0.0; var green: f32 = 52.0; var blue: f32 = 156.0;
    var saved_red: f32 = 32.0; var saved_green: f32 = 64.0; var saved_blue: f32 = 184.0;
    var mixing: bool = false;
    var change_paint: Entity = null; var mixer: Entity = null; var ok: Entity = null;
    var red_track: Entity = null; var green_track: Entity = null; var blue_track: Entity = null;
    var red_marker: Entity = null; var green_marker: Entity = null; var blue_marker: Entity = null;
    var paint: Entity = null;
    var spoiler0: Entity = null; var spoiler1: Entity = null; var spoiler2: Entity = null; var spoiler3: Entity = null; var spoiler4: Entity = null;
    var stripe_none: Entity = null; var stripe_white: Entity = null; var stripe_green: Entity = null;
    var stripe_black: Entity = null; var stripe_pink: Entity = null;
    var stripe0: Entity = null; var stripe1: Entity = null; var stripe2: Entity = null; var stripe3: Entity = null; var stripe4: Entity = null;
    var stripe_index: f32 = 0.0;
    // `skift` (button 395) is the purchase: 500 kr and BMW cred replaced up to
    // 0.15 (`bil_cool += 0.15 - farve_cool`), then the mixer opens. When the
    // till refuses, the original shows "Din fattiglus!" and the mixer stays shut.
    var paint_cool: f32 = 0.0;
    var ticket: f32 = 0.0;
    var asking: bool = false;
    // The `fartstribe` swatches cost 250 kr each (buttons 177/168/172/164/160).
    // A stripe is worth 0.1 cred (`bil_cool += 0.1 - farvestribe_cool`) and
    // removing it takes the 0.1 back. The fitted swatch has no button, as in
    // the original, where its frame of `fartstribe` draws the tick instead.
    var stripe_cool: f32 = 0.0;
    var stripe_pending: f32 = -1.0;
    var stripe_ticket: f32 = 0.0;

    fn start() {
        this.change_paint = World.find("Workshop Paint Change"); this.mixer = World.find("Workshop RGB Mixer");
        this.ok = World.find("Workshop RGB OK"); this.red_track = World.find("Workshop RGB Red");
        this.green_track = World.find("Workshop RGB Green"); this.blue_track = World.find("Workshop RGB Blue");
        this.red_marker = World.find("Workshop RGB Red Marker"); this.green_marker = World.find("Workshop RGB Green Marker"); this.blue_marker = World.find("Workshop RGB Blue Marker");
        this.stripe_none = World.find("Workshop Stripe None"); this.stripe_white = World.find("Workshop Stripe White");
        this.stripe_green = World.find("Workshop Stripe Green"); this.stripe_black = World.find("Workshop Stripe Black"); this.stripe_pink = World.find("Workshop Stripe Pink");
        this.paint = World.find("Garage Car paint-tintable");
        this.spoiler0 = World.find("Garage Car spoiler-1"); this.spoiler1 = World.find("Garage Car spoiler-2");
        this.spoiler2 = World.find("Garage Car spoiler-3"); this.spoiler3 = World.find("Garage Car spoiler-4");
        this.spoiler4 = World.find("Garage Car spoiler-5");
        this.stripe0 = World.find("Garage Car farvestribe-empty"); this.stripe1 = World.find("Garage Car farvestribe-hvid");
        this.stripe2 = World.find("Garage Car farvestribe-grøn"); this.stripe3 = World.find("Garage Car farvestribe-sort"); this.stripe4 = World.find("Garage Car farvestribe-pink");
        layout_controls(); sync_sliders(); publish_rgb(); refresh_paint(); refresh_stripe(); set_mixer(false);
    }

    fn place(entity: Entity, x: f32, y: f32, w: f32, h: f32, unit: f32) {
        entity.transform.position.x = (x - 250.0) * unit;
        entity.transform.position.y = (250.0 - y) * unit;
        entity.transform.scale.x = w * unit;
        entity.transform.scale.y = h * unit;
    }

    fn marker_y(value: f32) -> f32 { return 446.0 - (value / 255.0) * 78.0; }

    fn layout_controls() {
        let unit = 0.004 * min(Viewport.aspect, 1.0);
        // The original's button rects (sprite 896 and `fartstribe`, frame 722).
        place(this.change_paint, 213.87, 426.92, 57.2, 33.3, unit);
        place(this.stripe_none, 367.0, 402.8, 35.8, 25.9, unit); place(this.stripe_white, 406.0, 402.8, 35.8, 25.9, unit);
        place(this.stripe_green, 367.0, 431.6, 35.8, 25.9, unit); place(this.stripe_black, 406.2, 432.0, 35.8, 25.9, unit); place(this.stripe_pink, 445.7, 432.0, 35.8, 25.9, unit);
        place(this.mixer, 324.5, 406.5, 343.0, 111.0, unit);
        place(this.red_track, 185.0, 407.0, 18.0, 78.0, unit); place(this.green_track, 213.0, 407.0, 18.0, 78.0, unit); place(this.blue_track, 241.0, 407.0, 18.0, 78.0, unit);
        place(this.red_marker, 185.0, marker_y(this.red), 16.0, 7.0, unit); place(this.green_marker, 213.0, marker_y(this.green), 16.0, 7.0, unit); place(this.blue_marker, 241.0, marker_y(this.blue), 16.0, 7.0, unit);
        place(this.ok, 459.0, 431.0, 54.0, 38.0, unit);
    }

    fn sync_sliders() { Ui.set_slider_value(this.red_track, this.red); Ui.set_slider_value(this.green_track, this.green); Ui.set_slider_value(this.blue_track, this.blue); }
    fn publish_rgb() { Game.set("workshop.paint.red", this.red); Game.set("workshop.paint.green", this.green); Game.set("workshop.paint.blue", this.blue); }
    // `paint-tintable` is a flat silhouette mask, a uniform RGB(49,49,49), so a
    // tint could never reach the colour the sliders ask for: multiplying only
    // scales what the art already has, and 49/255 caps every paint job at 19%
    // brightness. Pure red came out RGB(49,6,6), which is why every paint job
    // looked nearly black.
    //
    // The colour transform replaces the sample instead of scaling it: a zero
    // multiply discards the mask's grey and the offset supplies the colour
    // whole, so the slider value lands exactly. The alpha channels stay at the
    // identity — multiply 1, offset 0 — because the mask's alpha is the car's
    // silhouette, and an offset there would fill its transparent corners with
    // a rectangle.
    //
    // The active workshop also owns spoiler paint synchronization. The old
    // garage_polish controller is deliberately excluded from exported scenes.
    // Slider values are sRGB bytes, but the sprite's colour transform works
    // in linear light, so 00349C written straight in showed as 007DCD. Decay
    // has no `pow`, so the 2.4 power of the sRGB curve is b^2 * b^(1/4) *
    // b^(1/8) = b^2.375, which lands within one byte of the exact curve.
    fn to_linear(byte: f32) -> f32 {
        let c = clamp(byte / 255.0, 0.0, 1.0);
        if c <= 0.04045 { return c / 12.92; }
        let b = (c + 0.055) / 1.055;
        let q = sqrt(sqrt(b));
        return b * b * q * sqrt(q);
    }
    fn paint_spoiler(entity: Entity) {
        let wing = entity;
        wing.sprite.tint.r = 1.0; wing.sprite.tint.g = 1.0; wing.sprite.tint.b = 1.0;
        wing.sprite.color_multiply.r = 0.0; wing.sprite.color_multiply.g = 0.0; wing.sprite.color_multiply.b = 0.0;
        wing.sprite.color_offset.r = to_linear(this.red); wing.sprite.color_offset.g = to_linear(this.green); wing.sprite.color_offset.b = to_linear(this.blue);
    }
    fn refresh_paint() {
        let body = this.paint;
        body.sprite.tint.r = to_linear(this.red); body.sprite.tint.g = to_linear(this.green); body.sprite.tint.b = to_linear(this.blue);
        body.sprite.color_multiply.r = 0.0; body.sprite.color_multiply.g = 0.0; body.sprite.color_multiply.b = 0.0;
        body.sprite.color_offset.r = to_linear(this.red); body.sprite.color_offset.g = to_linear(this.green); body.sprite.color_offset.b = to_linear(this.blue);
        paint_spoiler(this.spoiler0); paint_spoiler(this.spoiler1); paint_spoiler(this.spoiler2);
        paint_spoiler(this.spoiler3); paint_spoiler(this.spoiler4);
        publish_rgb();
    }
    fn read_sliders() {
        let next_red = Ui.slider_value(this.red_track); let next_green = Ui.slider_value(this.green_track); let next_blue = Ui.slider_value(this.blue_track);
        if next_red != this.red || next_green != this.green || next_blue != this.blue { this.red = next_red; this.green = next_green; this.blue = next_blue; refresh_paint(); }
    }
    fn set_mixer(value: bool) {
        this.mixing = value;
        // The panel art hides LAKKERING's own picture while the mixer is open.
        if value { Game.set("workshop.paint.mixing", 1.0); } else { Game.set("workshop.paint.mixing", 0.0); }
        World.set_active(this.mixer, value); World.set_active(this.ok, value);
        World.set_active(this.red_track, value); World.set_active(this.green_track, value); World.set_active(this.blue_track, value);
        World.set_active(this.red_marker, value); World.set_active(this.green_marker, value); World.set_active(this.blue_marker, value);
        World.set_active(this.change_paint, !value);
        show_swatches(!value);
    }
    fn show_swatches(value: bool) {
        World.set_active(this.stripe_none, value && this.stripe_index != 0.0); World.set_active(this.stripe_white, value && this.stripe_index != 1.0);
        World.set_active(this.stripe_green, value && this.stripe_index != 2.0); World.set_active(this.stripe_black, value && this.stripe_index != 3.0);
        World.set_active(this.stripe_pink, value && this.stripe_index != 4.0);
    }
    fn set_stripe(index: f32) { this.stripe_index = index; Game.set("workshop.stripe", index); refresh_stripe(); show_swatches(!this.mixing); }
    fn ask_stripe(index: f32) {
        if this.asking || this.stripe_pending >= 0.0 || index == this.stripe_index { return; }
        this.stripe_ticket = Game.get("workshop.buy.ticket", 0.0) + 1.0;
        this.stripe_pending = index;
        Game.set("workshop.buy.price", 250.0);
        if index == 0.0 { Game.set("workshop.buy.cred", 0.0 - this.stripe_cool); }
        else { Game.set("workshop.buy.cred", 0.1 - this.stripe_cool); }
        Game.set("workshop.buy.ticket", this.stripe_ticket);
    }
    fn settle_stripe() {
        if this.stripe_pending < 0.0 { return; }
        if Game.get("workshop.buy.settled", 0.0) != this.stripe_ticket { return; }
        if Game.get("workshop.buy.granted", 0.0) > 0.0 {
            if this.stripe_pending == 0.0 { this.stripe_cool = 0.0; } else { this.stripe_cool = 0.1; }
            set_stripe(this.stripe_pending);
        }
        this.stripe_pending = -1.0;
    }
    fn refresh_stripe() {
        World.set_active(this.stripe0, this.stripe_index == 0.0); World.set_active(this.stripe1, this.stripe_index == 1.0); World.set_active(this.stripe2, this.stripe_index == 2.0); World.set_active(this.stripe3, this.stripe_index == 3.0); World.set_active(this.stripe4, this.stripe_index == 4.0);
    }
    fn ask_paint() {
        this.ticket = Game.get("workshop.buy.ticket", 0.0) + 1.0;
        this.asking = true;
        Game.set("workshop.buy.price", 500.0);
        Game.set("workshop.buy.cred", 0.15 - this.paint_cool);
        Game.set("workshop.buy.ticket", this.ticket);
    }
    fn settle_paint() {
        if !this.asking { return; }
        if Game.get("workshop.buy.settled", 0.0) != this.ticket { return; }
        this.asking = false;
        if Game.get("workshop.buy.granted", 0.0) > 0.0 {
            this.paint_cool = 0.15;
            this.saved_red = this.red; this.saved_green = this.green; this.saved_blue = this.blue;
            sync_sliders(); set_mixer(true);
        }
    }
    fn update(dt: f32) {
        if Ui.is_pressed(this.change_paint) && !this.asking && this.stripe_pending < 0.0 { ask_paint(); }
        settle_paint(); settle_stripe();
        // Leaving LAKKERING closes the mixer, as the panel it sits in goes away.
        let here = Game.get("workshop.category", 0.0) == 0.0;
        if this.mixing && !here { set_mixer(false); }
        show_swatches(here && !this.mixing);
        World.set_active(this.change_paint, here && !this.mixing);
        if this.mixing { read_sliders(); if Ui.is_pressed(this.ok) { set_mixer(false); } }
        else {
            if Ui.is_pressed(this.stripe_none) { ask_stripe(0.0); } if Ui.is_pressed(this.stripe_white) { ask_stripe(1.0); } if Ui.is_pressed(this.stripe_green) { ask_stripe(2.0); } if Ui.is_pressed(this.stripe_black) { ask_stripe(3.0); } if Ui.is_pressed(this.stripe_pink) { ask_stripe(4.0); }
        }
        layout_controls();
    }
}
