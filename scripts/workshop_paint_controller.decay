// LAKKERING mirrors the original two-step flow: the normal panel contains
// `skift`; pressing it opens the native RGB sliders and OK commits the preview.
script WorkshopPaintController {
    var red: f32 = 32.0; var green: f32 = 64.0; var blue: f32 = 184.0;
    var saved_red: f32 = 32.0; var saved_green: f32 = 64.0; var saved_blue: f32 = 184.0;
    var mixing: bool = false;
    var change_paint: Entity = null; var mixer: Entity = null; var ok: Entity = null;
    var red_track: Entity = null; var green_track: Entity = null; var blue_track: Entity = null;
    var red_marker: Entity = null; var green_marker: Entity = null; var blue_marker: Entity = null;
    var paint: Entity = null;
    var stripe_none: Entity = null; var stripe_white: Entity = null; var stripe_green: Entity = null;
    var stripe_black: Entity = null; var stripe_pink: Entity = null;
    var stripe0: Entity = null; var stripe1: Entity = null; var stripe2: Entity = null; var stripe3: Entity = null; var stripe4: Entity = null;
    var stripe_index: f32 = 0.0;

    fn start() {
        this.change_paint = World.find("Workshop Paint Change"); this.mixer = World.find("Workshop RGB Mixer");
        this.ok = World.find("Workshop RGB OK"); this.red_track = World.find("Workshop RGB Red");
        this.green_track = World.find("Workshop RGB Green"); this.blue_track = World.find("Workshop RGB Blue");
        this.red_marker = World.find("Workshop RGB Red Marker"); this.green_marker = World.find("Workshop RGB Green Marker"); this.blue_marker = World.find("Workshop RGB Blue Marker");
        this.stripe_none = World.find("Workshop Stripe None"); this.stripe_white = World.find("Workshop Stripe White");
        this.stripe_green = World.find("Workshop Stripe Green"); this.stripe_black = World.find("Workshop Stripe Black"); this.stripe_pink = World.find("Workshop Stripe Pink");
        this.paint = World.find("Garage Car paint-tintable");
        this.stripe0 = World.find("Garage Car farvestribe-empty"); this.stripe1 = World.find("Garage Car farvestribe-hvid");
        this.stripe2 = World.find("Garage Car farvestribe-grøn"); this.stripe3 = World.find("Garage Car farvestribe-sort"); this.stripe4 = World.find("Garage Car farvestribe-pink");
        layout_controls(); sync_sliders(); publish_rgb(); refresh_paint(); refresh_stripe(); set_mixer(false);
    }

    fn place(entity: Entity, x: f32, y: f32, w: f32, h: f32, unit: f32) {
        entity.transform.position.x = (x - 250.0) * unit;
        entity.transform.position.y = (250.0 - y) * unit;
        entity.transform.scale.x = w * unit;
        entity.transform.scale.y = h * unit;
    }

    fn marker_y(value: f32) -> f32 { return 446.0 - (value / 255.0) * 78.0; }

    fn layout_controls() {
        let unit = 0.004 * min(Viewport.aspect, 1.0);
        place(this.change_paint, 205.0, 433.0, 56.0, 38.0, unit);
        place(this.stripe_none, 359.0, 400.0, 34.0, 26.0, unit); place(this.stripe_white, 397.0, 400.0, 34.0, 26.0, unit);
        place(this.stripe_green, 359.0, 430.0, 34.0, 26.0, unit); place(this.stripe_black, 397.0, 430.0, 34.0, 26.0, unit); place(this.stripe_pink, 435.0, 430.0, 34.0, 26.0, unit);
        place(this.mixer, 324.5, 406.5, 343.0, 111.0, unit);
        place(this.red_track, 185.0, 407.0, 18.0, 78.0, unit); place(this.green_track, 213.0, 407.0, 18.0, 78.0, unit); place(this.blue_track, 241.0, 407.0, 18.0, 78.0, unit);
        place(this.red_marker, 185.0, marker_y(this.red), 16.0, 7.0, unit); place(this.green_marker, 213.0, marker_y(this.green), 16.0, 7.0, unit); place(this.blue_marker, 241.0, marker_y(this.blue), 16.0, 7.0, unit);
        place(this.ok, 459.0, 431.0, 54.0, 38.0, unit);
    }

    fn sync_sliders() { Ui.set_slider_value(this.red_track, this.red); Ui.set_slider_value(this.green_track, this.green); Ui.set_slider_value(this.blue_track, this.blue); }
    fn publish_rgb() { Game.set("workshop.paint.red", this.red); Game.set("workshop.paint.green", this.green); Game.set("workshop.paint.blue", this.blue); }
    fn refresh_paint() {
        let body = this.paint;
        body.sprite.tint.r = this.red / 255.0; body.sprite.tint.g = this.green / 255.0; body.sprite.tint.b = this.blue / 255.0;
        publish_rgb();
    }
    fn read_sliders() {
        let next_red = Ui.slider_value(this.red_track); let next_green = Ui.slider_value(this.green_track); let next_blue = Ui.slider_value(this.blue_track);
        if next_red != this.red || next_green != this.green || next_blue != this.blue { this.red = next_red; this.green = next_green; this.blue = next_blue; refresh_paint(); }
    }
    fn set_mixer(value: bool) {
        this.mixing = value;
        World.set_active(this.mixer, value); World.set_active(this.ok, value);
        World.set_active(this.red_track, value); World.set_active(this.green_track, value); World.set_active(this.blue_track, value);
        World.set_active(this.red_marker, value); World.set_active(this.green_marker, value); World.set_active(this.blue_marker, value);
        World.set_active(this.change_paint, !value);
        World.set_active(this.stripe_none, !value); World.set_active(this.stripe_white, !value); World.set_active(this.stripe_green, !value); World.set_active(this.stripe_black, !value); World.set_active(this.stripe_pink, !value);
    }
    fn set_stripe(index: f32) { this.stripe_index = index; Game.set("workshop.stripe", index); refresh_stripe(); }
    fn refresh_stripe() {
        World.set_active(this.stripe0, this.stripe_index == 0.0); World.set_active(this.stripe1, this.stripe_index == 1.0); World.set_active(this.stripe2, this.stripe_index == 2.0); World.set_active(this.stripe3, this.stripe_index == 3.0); World.set_active(this.stripe4, this.stripe_index == 4.0);
    }
    fn update(dt: f32) {
        if Ui.is_pressed(this.change_paint) { this.saved_red=this.red; this.saved_green=this.green; this.saved_blue=this.blue; sync_sliders(); set_mixer(true); }
        if this.mixing { read_sliders(); if Ui.is_pressed(this.ok) { set_mixer(false); } }
        else {
            if Ui.is_pressed(this.stripe_none) { set_stripe(0.0); } if Ui.is_pressed(this.stripe_white) { set_stripe(1.0); } if Ui.is_pressed(this.stripe_green) { set_stripe(2.0); } if Ui.is_pressed(this.stripe_black) { set_stripe(3.0); } if Ui.is_pressed(this.stripe_pink) { set_stripe(4.0); }
        }
        layout_controls();
    }
}
