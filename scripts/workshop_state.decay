// Canonical workshop state for the Mujaffa BMW.
// Purchases cost the recovered prices. `free_purchases` stays as a testing
// switch that skips payment without touching the economy data.
//
// Decay has no value that can hold an entity, so no script can call `purchase`
// directly -- a category controller cannot name this one. Buying therefore goes
// over the shared board: a controller leaves a price, a cred and a ticket, and
// this script settles it on the next frame and publishes the result. That is
// one till for all thirteen categories rather than thirteen copies of the rule,
// and it is why `purchase` is reachable at all.
script WorkshopState {
    var free_purchases: bool = false;
    var money: f32 = 5000.0;
    var street_cred: f32 = 0.0;
    var bmw_count: f32 = 1.0;
    var category: f32 = 0.0;
    var paint: f32 = 0.0;
    var audio: f32 = 0.0;
    var spoiler: f32 = 0.0;
    var exhaust: f32 = 0.0;
    var rims: f32 = 0.0;
    var tyres: f32 = 0.0;
    var windows: f32 = 0.0;
    var sunroof: f32 = 0.0;
    var plate: f32 = 0.0;
    var interior: f32 = 0.0;
    var trinket: f32 = 0.0;
    var horn: f32 = 0.0;
    var camera: f32 = 0.0;
    var stripe: f32 = 0.0;
    var plate_confirmed: f32 = 0.0;
    var plate_moused: f32 = 0.0;
    var plate_cool: bool = false;
    // Running totals the trip leaves on the board: gold picked up on the road
    // (`penge += ran`) and repairs paid in the garage. Only the change counts.
    var trip_earned: f32 = 0.0;
    var trip_spent: f32 = 0.0;

    // The last ticket settled. A controller raises the ticket to ask; this
    // never settles the same one twice.
    var settled: f32 = 0.0;
    // Global sequence. Each controller reserves the next number when it asks.
    // Category-local counters would collide on the first purchase in each panel.

    fn start() {
        Game.set("workshop.buy.ticket", 0.0);
        Game.set("workshop.buy.settled", 0.0);
        Game.set("workshop.buy.granted", 0.0);
        publish();
    }

    fn publish() {
        Game.set("workshop.money", this.money);
        Game.set("workshop.street_cred", this.street_cred);
    }

    fn purchase(price: f32, cred: f32) -> bool {
        if this.free_purchases {
            this.street_cred = this.street_cred + cred;
            return true;
        }
        if this.money < price { return false; }
        this.money = this.money - price;
        this.street_cred = this.street_cred + cred;
        return true;
    }

    fn update(dt: f32) {
        let earned = Game.get("trip.earned", 0.0);
        let spent = Game.get("trip.spent", 0.0);
        if earned != this.trip_earned || spent != this.trip_spent {
            this.money = max(this.money + (earned - this.trip_earned) - (spent - this.trip_spent), 0.0);
            this.trip_earned = earned;
            this.trip_spent = spent;
            publish();
        }
        let confirmed = Game.get("workshop.plate.confirmed", 0.0);
        if confirmed > this.plate_confirmed {
            this.plate_confirmed = confirmed;
            if !this.plate_cool {
                this.street_cred = this.street_cred + 0.3;
                this.plate_cool = true;
            }
            publish();
        }
        let moused = Game.get("workshop.plate.moused", 0.0);
        if moused > this.plate_moused {
            this.money = this.money + 20000.0 * (moused - this.plate_moused);
            this.plate_moused = moused;
            publish();
        }
        let ticket = Game.get("workshop.buy.ticket", 0.0);
        if ticket > this.settled {
            this.settled = ticket;
            let granted = purchase(Game.get("workshop.buy.price", 0.0), Game.get("workshop.buy.cred", 0.0));
            // The board carries numbers, so a refusal is 0 and a sale is 1.
            // The asking controller matches `settled` against its own ticket
            // before believing either.
            if granted { Game.set("workshop.buy.granted", 1.0); } else { Game.set("workshop.buy.granted", 0.0); }
            // Every refusal in the original raises `brokeassalert`; the trip
            // controller shows it whenever this count goes up.
            if !granted { Game.set("workshop.buy.refused", Game.get("workshop.buy.refused", 0.0) + 1.0); }
            Game.set("workshop.buy.settled", ticket);
            publish();
        }
    }

    fn set_category(value: f32) { this.category = value; }
}
